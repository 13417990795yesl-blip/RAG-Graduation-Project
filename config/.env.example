# Copy to config/.env and fill in your own key for LLM experiments.
DEEPSEEK_API_KEY=

# Optional local model directories. Empty values use the original models/ cache.
BGE_MODEL_PATH=
BGE_RERANKER_PATH=

# Existing experiment controls
MULTIHOPRAG_SAMPLE_SIZE=50
MULTIHOPRAG_METHODS=listwise,setselection

# Optional Hugging Face configuration
# HF_ENDPOINT=https://huggingface.co
# HF_HUB_DISABLE_SYMLINKS_WARNING=1
